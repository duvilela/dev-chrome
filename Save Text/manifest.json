{
  "manifest_version": 3,
  "name": "SaveText",
  "version": "1.0",
  "description": "Salva textos rapidamente do navegador em arquivos .txt e mantém um histórico no painel da extensão.",
  "permissions": [
    "contextMenus",
    "storage",
    "downloads",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
